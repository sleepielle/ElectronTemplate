{
  "name": "vite-project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "author": "meche:D",
  "description": "My Electron application description",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "e": "electron ."
  },
  "dependencies": {
    "bootstrap": "^5.1.0",
    "react": "^18.2.0",
    "react-bootstrap": "^2.5.0-beta.1",
    "react-dom": "^18.2.0"
  },
  "build": {
    "appId": "electron-react-vite",
    "win": {
      "target": [
        "nsis"
      ]
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "node_modules/**/*",
      "package.json"
    ],
    "nsis": {
      "uninstallDisplayName": "Uninstall this app",
      "license": "license.txt",
      "oneClick": "false",
      "allowToChangeInstallationDirectory": "true"
    },
    "directories": {
      "output": "releases",
      "buildResources": "dist"
    }
  },
  "devDependencies": {
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "@vitejs/plugin-react": "^3.1.0",
    "electron": "^24.0.0",
    "electron-builder": "^23.6.0",
    "vite": "^4.2.0"
  }
}
